# Database
# Använd SQLite lokalt (standard) eller PostgreSQL på Railway
DATABASE_URL=sqlite+aiosqlite:///./televera.db
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/televera

# API-säkerhet
SCRAPE_API_KEY=your-secret-key-here

# Scraping-inställningar
SCRAPE_CRON_HOURS=0,6,12,18
USED_PHONE_CATALOG_CRON_HOURS=1,7,13,19
USED_PHONE_CATALOG_UPDATE_ON_STARTUP=true
SCRAPE_TIMEZONE=Europe/Stockholm
SCRAPE_STALE_AFTER_HOURS=8
REQUEST_TIMEOUT_SECONDS=30
PLAYWRIGHT_HEADLESS=true

# CORS – tillåtna origins (kommaseparerade)
ALLOWED_ORIGINS=http://localhost:3000,https://televera.se

# Miljö
ENVIRONMENT=development

# Orderflöde
# Rekommenderat: Google Sheets API via service account.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=Orders

# Valfri fallback: Google Apps Script Web App URL som append:ar orderrader till Google Sheets.
GOOGLE_SHEETS_WEBHOOK_URL=

# Resend API används för orderbekräftelser. SMTP-inställningarna finns kvar som fallback.
RESEND_API_KEY=your-resend-api-key
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=your-resend-api-key
SMTP_FROM_EMAIL=order@televera.se
SMTP_FROM_NAME=Televera
SMTP_REPLY_TO=televerasverige@gmail.com
SMTP_USE_TLS=true
ORDER_ADMIN_EMAIL=
ORDER_SUBMISSION_TIMEOUT_SECONDS=10

# Automatiskt Trustpilot-mail efter order. START_DATE gör att äldre orderrader
# inte får retroaktiva utskick när funktionen aktiveras.
FEEDBACK_EMAIL_ENABLED=false
FEEDBACK_EMAIL_START_DATE=2026-07-23
TRUSTPILOT_REVIEW_URL=https://se.trustpilot.com/evaluate/televera.se
FEEDBACK_EMAIL_DELAY_DAYS=14
FEEDBACK_EMAIL_CRON_HOUR=9
FEEDBACK_EMAIL_CRON_MINUTE=15
FEEDBACK_EMAIL_BATCH_SIZE=50

# Social Farm – skapar ett svenskt, publiceringsklart bildspel varannan dag.
# Lokala bild- och textleverantörer kräver ingen extern AI-nyckel.
SOCIAL_FARM_ENABLED=false
SOCIAL_FARM_CRON_HOUR=8
SOCIAL_FARM_INTERVAL_HOURS=48
SOCIAL_FARM_TOPIC_COOLDOWN_DAYS=45
SOCIAL_FARM_STORAGE_DIR=data/social_farm
SOCIAL_FARM_COPY_PROVIDER=curated
SOCIAL_FARM_IMAGE_PROVIDER=local
SOCIAL_FARM_GENERATED_IMAGES_PER_POST=2

# Valfritt: sätt providers till "openai" och ange nyckeln för nygenererad
# copy och/eller nya bakgrundsbilder per inlägg.
OPENAI_API_KEY=
SOCIAL_FARM_TEXT_MODEL=gpt-5.6-luna
SOCIAL_FARM_IMAGE_MODEL=gpt-image-2
SOCIAL_FARM_IMAGE_QUALITY=medium

# Frontend
VITE_API_URL=https://cashmyphone-production.up.railway.app

# Only needed while the contact form still uses Supabase Edge Functions.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
